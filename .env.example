# ---------------------------------------------------------------------------
# Insights — environment template
#
# Copy to .env for local development:   cp .env.example .env
# .env is git-ignored and is NEVER committed or deployed.
#
# IMPORTANT — these values are read at BUILD time, not at run time.
# Vite inlines every VITE_* value into the JavaScript bundle when the app is
# built. Putting a .env on the cPanel server has NO effect on an already-built
# app: the bundle is plain static JS and never reads a file from disk. To
# change an endpoint you must rebuild and redeploy.
# (server-php is different — that backend does read its own .env at runtime.)
#
# Never put a secret here — anything VITE_* is public once built.
# ---------------------------------------------------------------------------

# --- API endpoints, per environment ----------------------------------------
# Base URL of the server-php API backend for each deploy target.
#
# These two names are mirrored as GitHub Actions repository variables
# (Settings > Secrets and variables > Actions > Variables). The deploy
# workflows read them to build for the matching target.
#
# NOTE: the hosts below are placeholders following the existing domain
# convention — replace them with the real server-php endpoints.
PROD_API_BASE_URL=https://api.insights.aicountly.com/api
SANDBOX_API_BASE_URL=https://api.insights.gh.aicountly.com/api

# --- Active build config ---------------------------------------------------
# The endpoint this particular build uses. Locally, point it at whichever of
# the two above you are developing against. In CI the deploy workflows set it
# automatically from PROD_API_BASE_URL or SANDBOX_API_BASE_URL.
VITE_API_BASE_URL=https://api.insights.gh.aicountly.com/api

# Display name shown in the UI.
VITE_APP_NAME=Insights

# Deploy target this build is for: local | sandbox | production
VITE_APP_ENV=local

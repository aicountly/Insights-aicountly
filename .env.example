# ---------------------------------------------------------------------------
# Insights — environment template
#
# Copy to .env for local development:   cp .env.example .env
# .env is git-ignored and is NEVER deployed. Values for CI builds come from
# GitHub repository variables (see .github/workflows/*.yml).
#
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never put secrets here — anything VITE_* is public once built.
# ---------------------------------------------------------------------------

# Base URL of the server-php API backend.
VITE_API_BASE_URL=https://REPLACE-ME.aicountly.com/api

# Display name shown in the UI.
VITE_APP_NAME=Insights

# Deploy target this build is for: local | sandbox | production
VITE_APP_ENV=local

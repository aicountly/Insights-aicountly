# ---------------------------------------------------------------------------
# Insights API — server environment template
#
# Unlike the React build, this file is read at RUNTIME on every request. It
# belongs on the server and only on the server:
#
#   1. Copy this file to <document root>/api/.env by hand, once (cPanel File
#      Manager or SSH).
#   2. It is git-ignored, and every rsync step passes --exclude='.env', so a
#      --delete deploy leaves it untouched.
#
# NEVER put a real credential in this file. Every value below is a placeholder.
# See docs/DEPLOYMENT.md and docs/INTEGRATION_MAP.md.
# ---------------------------------------------------------------------------

# Which deployment this is: production | sandbox | local
# Reported by GET /api/health, so you can tell the two environments apart.
APP_ENV=production

# This product's own name in cross-service calls. Siblings read it to avoid
# calling us back inside our own request. Leave it as is.
APP_PRODUCT_KEY=insights


# ---------------------------------------------------------------------------
# Database — Insights' OWN storage
#
# This holds dashboards, widgets, saved metric definitions, report definitions,
# anomaly reviews and preferences. It holds NO source transactions: every
# figure is read live from the product that owns it. There is no replication,
# no shadow ledger and no cron sync to configure here.
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=insights
DB_USER=insights
DB_PASS=set-this-on-the-server
# Postgres schema, if the database is shared. Defaults to public.
# DB_SCHEMA=public


# ---------------------------------------------------------------------------
# Authentication
#
# my.aicountly.com owns every token. This API never mints, signs or stores one.
# Leave PORTAL_AUTH_BASE unset unless you are pointing at a non-standard portal
# — my.aicountly.com serves BOTH production and sandbox. (sandbox.aicountly.com
# is a login redirect only; it does not serve seskey or validatesession.)
# ---------------------------------------------------------------------------
# PORTAL_AUTH_BASE=https://my.aicountly.com

# Comma-separated origins allowed to call this API cross-origin.
# Both deployed environments are same-origin with their app, so leave this
# empty in production. It exists for `npm run dev` against a deployed API.
# CORS_ALLOWED_ORIGINS=http://localhost:5173


# ---------------------------------------------------------------------------
# Source products
#
# Every one of these is OPTIONAL. Unset, the base is derived from this server's
# own hostname, so a sandbox deployment talks to sandbox siblings without a
# second set of variables to keep in step. Set one only to point somewhere else.
#
# A value naming a host outside the AICOUNTLY allowlist is IGNORED and logged —
# this product never accepts an arbitrary network destination.
# ---------------------------------------------------------------------------

# Books owns every accounting effect: revenue, purchases, tax, receivables,
# payables, cash. Most metrics resolve here.
# BOOKS_API_BASE=https://books.aicountly.com/api

# Inventory owns quantity, cost, valuation and COGS.
# INVENTORY_API_BASE=https://inventory.aicountly.com/api

# Manage owns companies, branches and financial years, and is asked — on every
# scoped request — whether the caller may open the company they named.
# MANAGE_API_BASE=https://manage.aicountly.com/api

# The operational products. Insights reads their COVERAGE and their operational
# counts only: their money is already recorded by Books, and counting it again
# here would double count a sale.
# SALES_API_BASE=https://sales.aicountly.com/api
# PURCHASES_API_BASE=https://purchases.aicountly.com/api
# BILLING_API_BASE=https://billing.aicountly.com/api
# POS_API_BASE=https://pos.aicountly.com/api

# Narrow which source products this deployment uses, comma separated. Unset
# means the standard fleet. An operator narrows it; they do not have to
# enumerate it.
#   INSIGHTS_SOURCES=books,inventory,manage,sales
# INSIGHTS_SOURCES=


# ---------------------------------------------------------------------------
# AI — credentials live in Console, never here
#
# console.aicountly.org holds the provider keys. This API asks Console to
# resolve the key for this domain and module at call time; the key is never
# written to this file, never logged, never sent to the browser and never put
# in a prompt. There is no provider API-key setting in the customer-facing app.
#
# CONSOLE_SERVICE_KEY is the key THIS product presents to Console to prove it
# is Insights. It is not a provider key, and it is the one secret this file
# legitimately carries.
# ---------------------------------------------------------------------------
# CONSOLE_API_URL=https://console.aicountly.org/api
# CONSOLE_SERVICE_KEY=set-this-on-the-server
#
# The domain Console has on record for this deployment. Derived from the request
# host when unset, so sandbox never resolves production's binding.
# CONSOLE_AI_DOMAIN=insights.aicountly.com
#
# Which Console AI module this product draws its credential from.
# INSIGHTS_AI_MODULE=insights
#
# Seconds to wait for a model. Clamped to 10–120.
# INSIGHTS_AI_TIMEOUT_SECONDS=45


# ---------------------------------------------------------------------------
# Inbound service keys
#
# What a SIBLING product presents to call this one, as product:key pairs. The
# comparison is constant-time. Insights exposes very little — it is a reader,
# not a system of record — so most deployments leave this empty.
#
#   SERVICE_KEYS=books:<key>,manage:<key>
# ---------------------------------------------------------------------------
# SERVICE_KEYS=
